import numpy as np
import numpy.typing as npt

_F64 = npt.NDArray[np.float64]
_F32 = npt.NDArray[np.float32]
_Path = npt.NDArray[np.intp]

def dtw_f64(a: _F64, b: _F64, metric: int, window: int | None, n_jobs: int | None) -> float: ...
def dtw_f32(a: _F32, b: _F32, metric: int, window: int | None, n_jobs: int | None) -> float: ...
def dtw_path_f64(a: _F64, b: _F64, metric: int, window: int | None, n_jobs: int | None) -> tuple[float, _Path]: ...
def dtw_path_f32(a: _F32, b: _F32, metric: int, window: int | None, n_jobs: int | None) -> tuple[float, _Path]: ...
def cdist_f64(a: list[_F64], b: list[_F64], metric: int, window: int | None, n_jobs: int | None) -> _F64: ...
def cdist_f32(a: list[_F32], b: list[_F32], metric: int, window: int | None, n_jobs: int | None) -> _F64: ...
def pdist_f64(s: list[_F64], metric: int, window: int | None, n_jobs: int | None) -> _F64: ...
def pdist_f32(s: list[_F32], metric: int, window: int | None, n_jobs: int | None) -> _F64: ...
